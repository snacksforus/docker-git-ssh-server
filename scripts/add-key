#!/bin/zsh
set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print error and exit
error_exit() {
    echo -e "${RED}Error: $1${NC}" >&2
    exit 1
}

# Function to print success
success() {
    echo -e "${GREEN}$1${NC}"
}

# Function to print warning
warning() {
    echo -e "${YELLOW}Warning: $1${NC}"
}

# Check if key file argument is provided
if [ $# -ne 1 ]; then
    error_exit "Usage: $0 <path-to-public-key-file>"
fi

KEY_FILE="$1"
CONTAINER_NAME="${DOCKER_CONTAINER:-git-server}"

# Check if key file exists
if [ ! -f "$KEY_FILE" ]; then
    error_exit "Key file not found: $KEY_FILE"
fi

# Check if key file is readable
if [ ! -r "$KEY_FILE" ]; then
    error_exit "Key file is not readable: $KEY_FILE"
fi

# Validate key file is not empty
if [ ! -s "$KEY_FILE" ]; then
    error_exit "Key file is empty: $KEY_FILE"
fi

# Validate SSH public key format
# SSH public keys should start with ssh-rsa, ssh-ed25519, ecdsa-sha2-nistp256, etc.
KEY_CONTENT=$(cat "$KEY_FILE")
if ! echo "$KEY_CONTENT" | grep -qE '^(ssh-rsa|ssh-ed25519|ecdsa-sha2-nistp[0-9]+|sk-(ssh-ed25519|ecdsa-sha2-nistp256)@openssh\.com) [A-Za-z0-9+/]'; then
    error_exit "Invalid SSH public key format. Expected format: ssh-rsa AAAA... or ssh-ed25519 AAAA..."
fi

# Additional validation: check key has at least 2 fields (type and key data)
FIELD_COUNT=$(echo "$KEY_CONTENT" | awk '{print NF}')
if [ "$FIELD_COUNT" -lt 2 ]; then
    error_exit "Invalid SSH public key: missing required fields"
fi

# Validate using ssh-keygen if available
if command -v ssh-keygen &> /dev/null; then
    if ! ssh-keygen -l -f "$KEY_FILE" &> /dev/null; then
        error_exit "ssh-keygen validation failed: not a valid SSH public key"
    fi

    # Get key info
    KEY_INFO=$(ssh-keygen -l -f "$KEY_FILE")
    echo "Key information: $KEY_INFO"
else
    warning "ssh-keygen not found, skipping advanced validation"
fi

# Check if Docker is available
if ! command -v docker &> /dev/null; then
    error_exit "Docker command not found. Please install Docker."
fi

# Check if container is running
if ! docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
    error_exit "Container '${CONTAINER_NAME}' is not running"
fi

echo "Adding SSH key to container: ${CONTAINER_NAME}"

# Add key directly to authorized_keys by piping through stdin
# Run as git user to avoid permission issues with --read-only containers
# This avoids writing to container's filesystem (works with --read-only)
#if ! cat "$KEY_FILE" | docker exec -i -u git "${CONTAINER_NAME}" sh -c "cat >> /home/git/.ssh/authorized_keys && \
#  chmod 600 /home/git/.ssh/authorized_keys"; then
#    error_exit "Failed to add key to authorized_keys"
#fi
#
#success "SSH key successfully added to ${CONTAINER_NAME}"

# Count total keys
KEY_COUNT=$(docker exec "${CONTAINER_NAME}" sh -c "grep -c '^ssh-' /home/git/.ssh/authorized_keys 2>/dev/null || true")
if [ -z "$KEY_COUNT" ]; then
    KEY_COUNT=0
fi
echo "Total authorized keys: ${KEY_COUNT}"
